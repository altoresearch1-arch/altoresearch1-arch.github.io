{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laboratorio",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import http.server,functools;h=http.server.SimpleHTTPRequestHandler;h.extensions_map['.html']='text/html; charset=utf-8';http.server.test(HandlerClass=functools.partial(h,directory='laboratorio'),port=8778)"
      ],
      "port": 8778
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "app"],
      "port": 5173
    }
  ]
}
